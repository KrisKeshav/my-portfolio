# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real keys.

# Get a free API key at https://resend.com (used to send the visit-notification email)
RESEND_API_KEY=your_resend_api_key_here

# Where visit notifications should be sent — your Gmail address works fine
# as the *recipient*; Resend handles the actual sending.
NOTIFY_EMAIL=kriskeshv99@gmail.com

# Optional ipinfo.io API token for visitor geolocation lookups
IPINFO_TOKEN=your_ipinfo_token_here

# Server-only key for the portfolio chat route. Do not prefix with NEXT_PUBLIC_.
GROQ_API_KEY=your_groq_api_key_here
